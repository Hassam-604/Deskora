<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deskora.Core.ViewModels;assembly=Deskora.Core"
             x:Class="Deskora.App.Views.WallpapersView"
             x:DataType="vm:WallpapersViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36" Spacing="22">
            <!-- Header -->
            <StackPanel Spacing="8">
                <Border Classes="badge-pill" HorizontalAlignment="Left">
                    <TextBlock Classes="badge-text" Text="Planned for Milestone 0.2.0" />
                </Border>

                <TextBlock Text="Local Wallpaper Studio"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="{Binding Description}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <!-- Planned Architecture Specification Card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Planned Architecture &amp; Platform Integration"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,14,10">
                            <TextBlock Text="• Windows Desktop Wallpaper COM API" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Uses IDesktopWallpaper to configure per-monitor backgrounds safely without corrupting registry keys." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="14,0,0,10">
                            <TextBlock Text="• Local Asset Caching" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="SkiaSharp-based low-memory image thumbnail decoding with disk cache to prevent UI freezing." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,10,14,0">
                            <TextBlock Text="• Multi-Monitor Coordinate Mapping" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Detects display device paths, virtual screen bounding boxes, and resolutions." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="14,10,0,0">
                            <TextBlock Text="• Safe Snapshot &amp; Rollback" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Records original wallpaper paths prior to applying changes for 1-click restore." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sample UI Preview Layout -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Interface Design Preview"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="Visual Preview Only" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <!-- Mockup Grid of Wallpaper Cards -->
                <Grid ColumnDefinitions="*,*,*">
                    <!-- Sample Card 1 -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
                        <StackPanel Spacing="10">
                            <Border Height="120" Background="#1E293B" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <Path Data="{StaticResource IconWallpaper}" Fill="{DynamicResource TextMutedBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Text="Sample: Nordic Dawn" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Nordic Dawn 4K" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="3840 × 2160 • Landscape" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Sample Card 2 -->
                    <Border Grid.Column="1" Classes="card" Margin="4,0,4,0">
                        <StackPanel Spacing="10">
                            <Border Height="120" Background="#1E293B" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <Path Data="{StaticResource IconWallpaper}" Fill="{DynamicResource TextMutedBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Text="Sample: Deep Cosmos" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Deep Cosmos Ultra" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="5120 × 2880 • Wide" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Sample Card 3 -->
                    <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
                        <StackPanel Spacing="10">
                            <Border Height="120" Background="#1E293B" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <Path Data="{StaticResource IconWallpaper}" Fill="{DynamicResource TextMutedBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                    <TextBlock Text="Sample: Minimal Gradient" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Minimal Gradient" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="2560 × 1440 • Duo-tone" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Safety Banner -->
            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrandBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="System protection note: Deskora 0.1.0 does not perform wallpaper modifications. All wallpaper APIs will be implemented and tested in Milestone 0.2.0."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
