<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deskora.Core.ViewModels;assembly=Deskora.Core"
             x:Class="Deskora.App.Views.LiveWallpapersView"
             x:DataType="vm:LiveWallpapersViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36" Spacing="22">
            <StackPanel Spacing="8">
                <Border Classes="badge-pill" HorizontalAlignment="Left">
                    <TextBlock Classes="badge-text" Text="Planned for Milestone 0.6.0" />
                </Border>

                <TextBlock Text="Live &amp; Video Wallpapers"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="{Binding Description}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Technical Verification Plan (Windows WorkerW)"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Text="Live wallpapers require placing a video or web rendering surface behind desktop icons by parenting a child window to the Windows Explorer WorkerW window. Because this interacts directly with the desktop window hierarchy, it is treated as a high-verification feature."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,14,10">
                            <TextBlock Text="• WorkerW Canvas Hooking" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="SendMessageTimeout to Progman to spawn a WorkerW sibling window between desktop icons and wallpaper." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="14,0,0,10">
                            <TextBlock Text="• Automatic GPU/CPU Pause" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Monitors foreground window fullscreen state to immediately pause video rendering during gaming or heavy workloads." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,10,14,0">
                            <TextBlock Text="• Isolated Subprocess Architecture" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Playback engine runs in a separate host process so a video decoder crash never terminates Deskora." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="14,10,0,0">
                            <TextBlock Text="• Safe Detach &amp; Restoration" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Clean detachment and desktop redraw on exit so the standard static wallpaper is seamlessly restored." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrandBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Milestone 0.6.0 will deliver an isolated proof of concept before any live wallpaper functionality is integrated into the main studio."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
