<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deskora.Core.ViewModels;assembly=Deskora.Core"
             x:Class="Deskora.App.Views.ThemesView"
             x:DataType="vm:ThemesViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36" Spacing="22">
            <StackPanel Spacing="8">
                <Border Classes="badge-pill" HorizontalAlignment="Left">
                    <TextBlock Classes="badge-text" Text="Planned for Milestone 0.8.0" />
                </Border>

                <TextBlock Text="Themes &amp; Visual Integration"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="{Binding Description}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Planned Theme Synchronization Scope"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,14,10">
                            <TextBlock Text="• Windows DWM System Accent Matching" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Extracts dominant palette colors from wallpapers and dynamically aligns system title bars and accent colors." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="14,0,0,10">
                            <TextBlock Text="• Cohesive Theme Bundling" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Packages wallpaper, matching widget skins, and icon styles into unified 1-click theme presets." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,10,14,0">
                            <TextBlock Text="• Light &amp; Dark Mode Automation" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Automatically alternates wallpaper and theme palettes according to sunrise/sunset or OS dark mode switches." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="14,10,0,0">
                            <TextBlock Text="• Default Theme Restorer" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Guaranteed fallback restore to original Windows default theme parameters at any time." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrandBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="System theme integration and automatic palette synchronization will be built in Milestone 0.8.0."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
