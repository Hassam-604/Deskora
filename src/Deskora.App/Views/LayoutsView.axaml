<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deskora.Core.ViewModels;assembly=Deskora.Core"
             x:Class="Deskora.App.Views.LayoutsView"
             x:DataType="vm:LayoutsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36" Spacing="22">
            <StackPanel Spacing="8">
                <Border Classes="badge-pill" HorizontalAlignment="Left">
                    <TextBlock Classes="badge-text" Text="Planned for Milestone 0.5.0" />
                </Border>

                <TextBlock Text="Desktop Layouts &amp; Presets"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="{Binding Description}"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="720" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Planned Desktop Grid Persistence Architecture"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,14,10">
                            <TextBlock Text="• Windows SysListView32 Querying" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Communicates with desktop ListView to read (LVM_GETITEMPOSITION) and restore (LVM_SETITEMPOSITION) icon coordinates." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="14,0,0,10">
                            <TextBlock Text="• Display Resolution Matching" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Tags presets with monitor topology (e.g. 2560x1440 primary + 1920x1080 secondary) for intelligent automatic profile switching." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,10,14,0">
                            <TextBlock Text="• Named JSON Layout Profiles" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Stores coordinates in clean, human-readable JSON files in the local app data folder with export/import support." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="14,10,0,0">
                            <TextBlock Text="• Safety &amp; Clean Fallback" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Preserves icon order and handles newly added or removed shortcuts gracefully without icon overlaps." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="10" Padding="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource AccentBrandBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Layout position capture will be verified and implemented in Milestone 0.5.0."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
